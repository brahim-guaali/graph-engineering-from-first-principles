# Copy to .env, or export these in your shell.
GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite   # first one, then fallback
GEMINI_RPM=8               # stay under the free tier's requests-per-minute limit
PLATFORM_URL=http://127.0.0.1:8700
